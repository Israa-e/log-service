

# Optional: enables the AI support chat dashboard feature; unset disables it.
OPENAI_API_KEY=

RETENTION_DAYS=30

# Bootstrap dashboard admin account, seeded once on first startup.
# Only used to create the initial account — create further users from the
# dashboard's Users page once logged in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session cookie signing secret for the dashboard. Use a long random value.
SESSION_SECRET=change-me
